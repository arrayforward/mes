build demo_entity: phony demo_entity.exe

build entity_algo: phony libentity_algo.a

build entity_tests: phony entity_tests.exe

build geocore: phony geocore/libgeocore.a

build libgeocore.a: phony geocore/libgeocore.a

build libsqlite3.a: phony storage/libsqlite3.a

build libunistore.a: phony storage/libunistore.a

build sqlite3: phony storage/libsqlite3.a

build unistore: phony storage/libunistore.a

