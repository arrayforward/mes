  OBJECT_FILE_DIR = geocore\CMakeFiles\geocore.dir\src
  TARGET_SUPPORT_DIR = geocore\CMakeFiles\geocore.dir

build geocore/CMakeFiles/geocore.dir/src/kernel.cpp.obj: CXX_COMPILER__geocore_unscanned_Release D$:/manufacture/geocore/src/kernel.cpp || cmake_object_order_depends_target_geocore
  CONFIG = Release
  DEP_FILE = geocore\CMakeFiles\geocore.dir\src\kernel.cpp.obj.d
  FLAGS = -O3 -DNDEBUG -std=c++17 -Wall -Wextra
  INCLUDES = -ID:/manufacture/geocore/include
  OBJECT_DIR = geocore\CMakeFiles\geocore.dir
  OBJECT_FILE_DIR = geocore\CMakeFiles\geocore.dir\src
  TARGET_SUPPORT_DIR = geocore\CMakeFiles\geocore.dir


# =============================================================================
# Link build statements for STATIC_LIBRARY target geocore


#############################################
# Link the static library geocore\libgeocore.a

build geocore/libgeocore.a: CXX_STATIC_LIBRARY_LINKER__geocore_Release geocore/CMakeFiles/geocore.dir/src/anchor_tree.cpp.obj geocore/CMakeFiles/geocore.dir/src/scene.cpp.obj geocore/CMakeFiles/geocore.dir/src/kernel.cpp.obj
  CONFIG = Release
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  OBJECT_DIR = geocore\CMakeFiles\geocore.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = geocore\libgeocore.a
  TARGET_PDB = geocore.a.dbg
  TARGET_SUPPORT_DIR = geocore\CMakeFiles\geocore.dir


#############################################
# Utility command for test

build geocore/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\manufacture\entity\build\geocore && "C:\Program Files\CMake\bin\ctest.exe" "
  DESC = Running tests...
  pool = console
  restat = 1

build geocore/test: phony geocore/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build geocore/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\manufacture\entity\build\geocore && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\manufacture\entity -BD:\manufacture\entity\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build geocore/edit_cache: phony geocore/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build geocore/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\manufacture\entity\build\geocore && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\manufacture\entity -BD:\manufacture\entity\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build geocore/rebuild_cache: phony geocore/CMakeFiles/rebuild_cache.util

