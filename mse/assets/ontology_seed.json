    },
    {
      "id": "rl-rework-flow-recheck",
      "antecedent": "ReworkSubmitted",
      "relation": "TRIGGERS",
      "consequent": "RecheckJudged",
      "confidence": 0.9,
      "note": "返修流程:提交 → 复检"
