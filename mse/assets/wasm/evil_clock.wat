;; ============================================================================
;; evil_clock.wat —— 测试夹具:声明白名单外环境导入的模块
;;
;; 烘焙静态闸必须拒绝它:导入 "env"."clock" ∉ mse.{attr_len,attr_get,
;; write_len,write_get,result} —— 任何环境能力伸手在定义结算期即被拒。
;; 模块本身可解析可加载(导入只在被调用时才需要链接),确保拒绝理由确实
;; 来自导入白名单检查而非加载失败。
;; ============================================================================
(module
  (import "env" "clock" (func $clock (result i64)))
  (memory (export "memory") 1)
  (func (export "mse_eval"))
)
